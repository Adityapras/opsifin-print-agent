<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Opsifin Print Agent"
    Manufacturer="Opsigo"
    Version="$(var.ProductVersion)"
    UpgradeCode="D869047A-A45C-4C3A-B1CE-3D716396B99D"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Opsifin Print Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="OpsifinAgentIcon.ico" SourceFile="$(var.BrandAssetsDir)\opsifin-agent.ico" />
    <Property Id="ARPPRODUCTICON" Value="OpsifinAgentIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="OpsigoDirectory" Name="Opsigo">
        <Directory Id="INSTALLFOLDER" Name="Opsifin Print Agent" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OpsifinProgramMenuFolder" Name="Opsifin" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Opsifin Print Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>

    <Property Id="WixUnelevatedShellExecTarget" Value="[#AgentControlExe]" />
    <CustomAction
      Id="LaunchAgentControl"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixUnelevatedShellExec"
      Execute="immediate"
      Return="ignore" />
    <InstallExecuteSequence>
      <!-- Shell milik user dipakai agar companion tray hidup di sesi desktop, bukan di sesi
           installer elevated. Companion membuka proses control terpisah melalui UAC. -->
      <Custom
        Action="LaunchAgentControl"
        After="InstallFinalize"
        Condition="NOT (REMOVE~=&quot;ALL&quot;) AND UILevel &gt;= 4" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Component Id="AgentServiceComponent" Guid="EEDBE435-B94A-4A50-BA56-83EE56419846">
        <File Id="AgentServiceExe" Source="$(var.AgentPublishDir)\Agent.Service.exe" KeyPath="yes" />
        <ServiceInstall
          Id="AgentServiceInstall"
          Name="OpsifinPrintAgent"
          DisplayName="Opsifin Print Agent"
          Description="Prints jobs from Opsifin Print Hub through Windows printers."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem">
          <ServiceDependency Id="Spooler" />
        </ServiceInstall>
        <ServiceControl
          Id="AgentServiceControl"
          Name="OpsifinPrintAgent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>

      <Component Id="PdfiumComponent" Guid="A2E30B9F-950A-417C-98ED-B26DA4A4048C">
        <File Id="PdfiumDll" Source="$(var.AgentPublishDir)\pdfium.dll" KeyPath="yes" />
      </Component>
      <Component Id="SqliteComponent" Guid="76B4214C-F087-4F9E-AB39-8C7B0B754D77">
        <File Id="SqliteDll" Source="$(var.AgentPublishDir)\e_sqlite3.dll" KeyPath="yes" />
      </Component>
      <Component Id="AppSettingsComponent" Guid="B269D49F-8AEF-4DCE-993B-831952909BFD" NeverOverwrite="yes">
        <File Id="AppSettingsJson" Source="$(var.AgentPublishDir)\appsettings.json" KeyPath="yes" />
      </Component>
      <Component Id="AgentControlComponent" Guid="79851E56-D757-4B5F-AF5C-AF1092C305E6">
        <File Id="AgentControlExe" Source="$(var.ControlPublishDir)\Opsifin.Agent.Control.exe" KeyPath="yes">
          <Shortcut
            Id="AgentControlStartMenuShortcut"
            Directory="OpsifinProgramMenuFolder"
            Name="Opsifin Agent Control"
            Description="Pairing, status, and diagnostics for Opsifin Print Agent"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="yes" />
          <Shortcut
            Id="AgentControlDesktopShortcut"
            Directory="DesktopFolder"
            Name="Opsifin Agent Control"
            Description="Pairing, status, and diagnostics for Opsifin Print Agent"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="yes" />
        </File>
        <!-- Companion tray berjalan sebagai user biasa saat login. Tindakan administratif
             diluncurkan terpisah melalui UAC hanya ketika Agent Control dibuka. -->
        <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="OpsifinPrintAgentTray"
          Value="&quot;[#AgentControlExe]&quot; --tray"
          Type="string" />
        <RemoveFolder Id="RemoveOpsifinProgramMenuFolder" Directory="OpsifinProgramMenuFolder" On="uninstall" />
      </Component>
      <Component Id="AgentUpdaterComponent" Guid="A06D289A-0D56-4B7B-A438-927A816FD00E">
        <File Id="AgentUpdaterExe" Source="$(var.UpdaterPublishDir)\Opsifin.Agent.Updater.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
