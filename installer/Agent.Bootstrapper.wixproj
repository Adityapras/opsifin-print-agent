<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>OpsifinPrintAgent-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)bin\x64\$(Configuration)\OpsifinPrintAgent.msi</MsiPath>
    <BrandAssetsDir Condition="'$(BrandAssetsDir)' == ''">$(MSBuildThisFileDirectory)..\assets\branding</BrandAssetsDir>
    <DistributionDir Condition="'$(DistributionDir)' == ''">$(MSBuildThisFileDirectory)..\dist</DistributionDir>
    <DefineConstants>MsiPath=$(MsiPath);BrandAssetsDir=$(BrandAssetsDir);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />
    <ProjectReference Include="Agent.Installer.wixproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <Target Name="CreateClientDistribution" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(DistributionDir)" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(DistributionDir)\OpsifinPrintAgent-Setup-$(Version)-win-x64.exe" />
  </Target>

</Project>
