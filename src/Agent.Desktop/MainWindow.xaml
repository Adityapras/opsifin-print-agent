<Window x:Class="Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opsifin Agent Control"
        Width="1180"
        Height="780"
        MinWidth="1040"
        MinHeight="680"
        Icon="Assets/opsifin-agent.ico"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Navy900Brush}">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Width="42"
                           Height="42"
                           Source="Assets/opsifin-agent.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock Text="OPSIFIN" Foreground="White" FontFamily="Bahnschrift SemiBold" FontSize="16" />
                        <TextBlock Text="AGENT CONTROL" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="MONITOR" Style="{StaticResource NavSectionText}" />
                    <Button Command="{Binding ShowDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="dashboard">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#0EA5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="Overview" FontWeight="SemiBold" />
                            <TextBlock Text="Service, Hub and printers" FontSize="11" Opacity="0.68" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="CONFIGURE" Style="{StaticResource NavSectionText}" Margin="15,22,0,7" />
                    <Button Command="{Binding ShowSetupCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="setup">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#0EA5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="Connection" FontWeight="SemiBold" />
                            <TextBlock Text="Pair this device with the Hub" FontSize="11" Opacity="0.68" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SUPPORT" Style="{StaticResource NavSectionText}" Margin="15,22,0,7" />
                    <Button Command="{Binding ShowSystemCheckCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="system-check">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="Health check" FontWeight="SemiBold" />
                            <TextBlock Text="Verify installation readiness" FontSize="11" Opacity="0.68" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowDiagnosticsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="diagnostics">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#0EA5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="Activity &amp; service" FontWeight="SemiBold" />
                            <TextBlock Text="Logs and service controls" FontSize="11" Opacity="0.68" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Background="#111C31" BorderBrush="#263449" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="MANAGED BY PRINT HUB" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding Version, StringFormat=Agent version {0}}" Foreground="#94A3B8" FontSize="11" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="34,19">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource DisplayText}" FontSize="17" />
                        <TextBlock Text="Windows print control center with safe updates" Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="{Binding LastStatusRefresh}" Foreground="{StaticResource Slate600Brush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Content="Refresh status" ToolTip="Reload the service state and health snapshot" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Dashboard -->
                <ScrollViewer Visibility="{Binding DashboardVisibility}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,30,34,36">
                        <TextBlock Text="Device health" Style="{StaticResource DisplayText}" FontSize="30" />
                        <TextBlock Text="A single view of the service, Hub connection, and every printer available to this device." Foreground="{StaticResource Slate600Brush}" FontSize="15" Margin="0,8,0,24" />

                        <Border CornerRadius="16" Padding="26" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallKind}" Value="success">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallKind}" Value="warning">
                                            <Setter Property="Background" Value="#FFFBEB" />
                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallKind}" Value="danger">
                                            <Setter Property="Background" Value="#FFF1F2" />
                                            <Setter Property="BorderBrush" Value="#FECDD3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="White" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <Ellipse Width="15" Height="15">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OverallKind}" Value="success"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding OverallKind}" Value="warning"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding OverallKind}" Value="danger"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallTitle}" Style="{StaticResource DisplayText}" FontSize="21" />
                                    <TextBlock Text="{Binding OverallDescription}" Foreground="{StaticResource Slate600Brush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="12,7">
                                    <TextBlock Text="{Binding RuntimeMode}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding SimulationModeActiveVisibility}"
                                Background="#FFF7ED"
                                BorderBrush="#FDBA74"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFEDD5" VerticalAlignment="Top">
                                    <TextBlock Text="TEST" Foreground="#C2410C" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Simulation mode — no paper output" Style="{StaticResource DisplayText}" FontSize="15" Foreground="#9A3412" />
                                    <TextBlock Text="Print Hub jobs are processed end to end using the simulated spooler. Completed means the workflow succeeded; it does not mean a physical printer produced paper."
                                               Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding UpdateVisibility}" CornerRadius="14" BorderThickness="1" Padding="22" Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateKind}" Value="ready">
                                            <Setter Property="Background" Value="#F0F9FF" />
                                            <Setter Property="BorderBrush" Value="#7DD3FC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UpdateKind}" Value="success">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UpdateKind}" Value="danger">
                                            <Setter Property="Background" Value="#FFF1F2" />
                                            <Setter Property="BorderBrush" Value="#FECDD3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Navy900Brush}" VerticalAlignment="Top">
                                    <TextBlock Text="↑" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,24,0">
                                    <TextBlock Text="{Binding UpdateTitle}" Style="{StaticResource DisplayText}" FontSize="18" />
                                    <TextBlock Text="{Binding UpdateDescription}" Foreground="{StaticResource Slate700Brush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" Background="#DBEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                                        <TextBlock Grid.Row="1" Text="{Binding UpdateProgressText}" HorizontalAlignment="Right" Margin="0,6,0,0" Foreground="{StaticResource Slate600Brush}" FontSize="10" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="210" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateVersionText}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,10" />
                                    <Button Content="Install update"
                                            Visibility="{Binding InstallUpdateVisibility}"
                                            Command="{Binding InstallUpdateCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,18,0,0" AutomationProperties.Name="Active print jobs">
                            <StackPanel>
                                <Grid Margin="22,20,22,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Print activity" Style="{StaticResource DisplayText}" FontSize="18" />
                                        <TextBlock Text="Live progress from this PC's Windows print spooler" Foreground="{StaticResource Slate700Brush}" FontSize="12" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding ClaimIntervalDescription}" Foreground="{StaticResource Slate600Brush}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding SourcePollDescription}" Visibility="{Binding SourcePollVisibility}" Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="12,6">
                                        <TextBlock Text="{Binding ActiveJobCountText}" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource Slate100Brush}" Margin="1,0" Padding="22,10" Visibility="{Binding ActiveJobListVisibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="INVOICE" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="TYPE" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="PRINTER" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="3" Text="PROGRESS" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="4" Text="PAGES" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="ELAPSED" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ActivePrintJobs}" Visibility="{Binding ActiveJobListVisibility}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="22,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.3*" />
                                                        <ColumnDefinition Width="0.8*" />
                                                        <ColumnDefinition Width="1.45*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="78" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{StaticResource Slate600Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Printer}" Foreground="{StaticResource Slate700Brush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Printer}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Border Grid.Column="3" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Stage}" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding Pages}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Elapsed}" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Visibility="{Binding ActiveJobEmptyVisibility}" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Margin="22,0,22,22" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="No print jobs are currently active" Style="{StaticResource DisplayText}" FontSize="15" HorizontalAlignment="Center" />
                                        <TextBlock Text="The Agent continues checking Print Hub using the interval shown above." Foreground="{StaticResource Slate600Brush}" TextAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                                <StackPanel><TextBlock Text="WINDOWS SERVICE" Foreground="{StaticResource Slate600Brush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding ServiceState}" Style="{StaticResource DisplayText}" FontSize="20" Margin="0,10,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="3,0,6,0">
                                <StackPanel><TextBlock Text="HUB CONNECTION" Foreground="{StaticResource Slate600Brush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding HubState}" Style="{StaticResource DisplayText}" FontSize="20" Margin="0,10,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,3,0">
                                <StackPanel><TextBlock Text="DETECTED PRINTERS" Foreground="{StaticResource Slate600Brush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding PrinterCount}" Style="{StaticResource DisplayText}" FontSize="24" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="9,0,0,0" ToolTip="Remote configuration revision currently accepted from Print Hub.">
                                <StackPanel><TextBlock Text="CONFIG VERSION" Foreground="{StaticResource Slate600Brush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding ConfigVersion}" Style="{StaticResource DisplayText}" FontSize="24" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid Margin="22,20,22,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Printers detected by Windows" Style="{StaticResource DisplayText}" FontSize="18" />
                                        <TextBlock Text="Snapshot from the last heartbeat accepted by the Hub. Printer names must match exactly." Foreground="{StaticResource Slate600Brush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrinterCount}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" />
                                            <TextBlock Text="  PRINTERS" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource Slate100Brush}" Margin="1,0" Padding="22,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PRINTER" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="STATUS" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="DRIVER" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="3" Text="PORT" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="4" Text="QUEUE" Foreground="{StaticResource Slate600Brush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Printers}" Visibility="{Binding PrinterListVisibility}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="22,13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Visibility="{Binding DefaultVisibility}" Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="8,0,10,0">
                                                            <TextBlock Text="DEFAULT" Foreground="{StaticResource AccentDarkBrush}" FontSize="9" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ONLINE"><Setter Property="Background" Value="#D1FAE5" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="OFFLINE"><Setter Property="Background" Value="#FFE4E6" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ERROR"><Setter Property="Background" Value="#FFE4E6" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="ONLINE"><Setter Property="Foreground" Value="#047857" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="OFFLINE"><Setter Property="Foreground" Value="#BE123C" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="ERROR"><Setter Property="Foreground" Value="#BE123C" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Driver}" Foreground="{StaticResource Slate600Brush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Driver}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Port}" Foreground="{StaticResource Slate600Brush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Port}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding QueueLength}" Style="{StaticResource DisplayText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Visibility="{Binding PrinterEmptyVisibility}" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Margin="22,18,22,22" Padding="20">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No printers in the latest heartbeat snapshot" Style="{StaticResource DisplayText}" FontSize="16" HorizontalAlignment="Center" />
                                        <TextBlock Text="Install the printer in Windows, restart the service, and wait for the next heartbeat." Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Identity &amp; connection" Style="{StaticResource DisplayText}" FontSize="18" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Agent ID" Foreground="{StaticResource Slate600Brush}" Margin="0,0,0,12" /><TextBlock Grid.Column="1" Text="{Binding AgentId}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="1" Text="Hub" Foreground="{StaticResource Slate600Brush}" Margin="0,0,0,12" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HubAddress}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="2" Text="Site ID" Foreground="{StaticResource Slate600Brush}" Margin="0,0,0,12" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteId}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="3" Text="Last heartbeat" Foreground="{StaticResource Slate600Brush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastHeartbeat}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Service controls" Style="{StaticResource DisplayText}" FontSize="18" />
                                    <TextBlock Text="Restart after changing the pairing or when the agent becomes unresponsive." Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" Margin="0,8,0,16" />
                                    <Button Content="Start service" Command="{Binding StartServiceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,9" />
                                    <Button Content="Restart service" Command="{Binding RestartServiceCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" />
                                    <Button Content="Stop service" Command="{Binding StopServiceCommand}" Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pairing -->
                <ScrollViewer Visibility="{Binding SetupVisibility}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,30,34,36">
                        <TextBlock Text="Pairing &amp; setup" Style="{StaticResource DisplayText}" FontSize="30" />
                        <TextBlock Text="Connect this PC without a command line. The device secret is protected by Windows DPAPI and is never displayed again." Foreground="{StaticResource Slate600Brush}" FontSize="15" Margin="0,8,0,24" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="28">
                                <StackPanel>
                                    <TextBlock Text="Connect to Print Hub" Style="{StaticResource DisplayText}" FontSize="22" />
                                    <TextBlock Text="{Binding PairingStatusText}" Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,22" />

                                    <TextBlock Text="Hub address" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Text="{Binding PairingHubUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: https://print.example.com or http://localhost:8000 for development" />
                                    <TextBlock Text="The agent automatically uses the /agent/v1 endpoint. HTTP is allowed only for localhost." Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,7,0,18" TextWrapping="Wrap" />

                                    <TextBlock Text="Pairing code" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" CharacterCasing="Upper" FontFamily="Cascadia Mono, Consolas" FontSize="18" ToolTip="8-character code generated by the Hub" />
                                    <TextBlock Text="The code can be used once and expires after a limited time." Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,7,0,20" />

                                    <Border Visibility="{Binding OperationVisibility}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border"><Setter Property="Background" Value="#EFF6FF" /><Setter Property="BorderBrush" Value="#BFDBFE" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding OperationKind}" Value="success"><Setter Property="Background" Value="#ECFDF5" /><Setter Property="BorderBrush" Value="#A7F3D0" /></DataTrigger><DataTrigger Binding="{Binding OperationKind}" Value="warning"><Setter Property="Background" Value="#FFFBEB" /><Setter Property="BorderBrush" Value="#FDE68A" /></DataTrigger><DataTrigger Binding="{Binding OperationKind}" Value="danger"><Setter Property="Background" Value="#FFF1F2" /><Setter Property="BorderBrush" Value="#FECDD3" /></DataTrigger></Style.Triggers></Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" />
                                    </Border>

                                    <Button Content="{Binding PairButtonText}" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />

                                    <Border Visibility="{Binding ResetPairingVisibility}" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Need to pair this device again?" FontWeight="SemiBold" Foreground="#9A3412" />
                                            <TextBlock Text="Revoke the previous agent in the Hub first. The local identity will be archived for recovery." Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,6,0,12" />
                                            <Button Content="Reset local pairing" Command="{Binding ResetPairingCommand}" Style="{StaticResource DangerButton}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiBold" FontSize="13" />
                                        <TextBlock Text="Create a pairing code" Style="{StaticResource DisplayText}" FontSize="18" Margin="0,8,0,4" />
                                        <TextBlock Text="An administrator creates a code for the destination site in the Hub." Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiBold" FontSize="13" />
                                        <TextBlock Text="Connect the device" Style="{StaticResource DisplayText}" FontSize="18" Margin="0,8,0,4" />
                                        <TextBlock Text="The app exchanges the code for an identity, protects the secret, and starts the service." Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiBold" FontSize="13" />
                                        <TextBlock Text="Manage from the Hub" Style="{StaticResource DisplayText}" FontSize="18" Margin="0,8,0,4" />
                                        <TextBlock Text="Printer bindings, routing, retries, and test pages stay centrally managed across all PCs." Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="26">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="LOCAL TESTING MODE" Foreground="#C2410C" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationModeTitle}" Style="{StaticResource DisplayText}" FontSize="21" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SimulationModeDescription}" Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" />

                                    <Border Visibility="{Binding SimulationModeWarningVisibility}" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0">
                                        <TextBlock Text="TEST ENVIRONMENT: completed jobs are reported to the Hub, but nothing is sent to a Windows printer."
                                                   Foreground="#9A3412" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border CornerRadius="16" Padding="12,7" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSimulationModeEnabled}" Value="True">
                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                        <Setter Property="BorderBrush" Value="#FDBA74" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SimulationModeBadge}" FontSize="11" FontWeight="Bold" TextAlignment="Center" />
                                    </Border>
                                    <Button Content="{Binding SimulationModeButtonText}"
                                            Command="{Binding ToggleSimulationModeCommand}"
                                            HorizontalAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSimulationModeEnabled}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#F97316" />
                                                        <Setter Property="Foreground" Value="#C2410C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="The service restarts automatically after confirmation." Foreground="{StaticResource Slate600Brush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- System Check -->
                <ScrollViewer Visibility="{Binding SystemCheckVisibility}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,30,34,36">
                        <Grid>
                            <StackPanel Margin="0,0,320,0">
                                <TextBlock Text="System Check" Style="{StaticResource DisplayText}" FontSize="30" />
                                <TextBlock Text="Validate a client PC and export a safe diagnostic report before pairing or test printing." Foreground="{StaticResource Slate600Brush}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="Export report ZIP" Command="{Binding ExportSystemCheckCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" ToolTip="Does not include the device secret, pairing code, or document contents" />
                                <Button Content="{Binding SystemCheckButtonText}" Command="{Binding RunSystemCheckCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="16" Padding="24" BorderThickness="1" Margin="0,24,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemCheckKind}" Value="success"><Setter Property="Background" Value="#ECFDF5" /><Setter Property="BorderBrush" Value="#A7F3D0" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SystemCheckKind}" Value="warning"><Setter Property="Background" Value="#FFFBEB" /><Setter Property="BorderBrush" Value="#FDE68A" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SystemCheckKind}" Value="danger"><Setter Property="Background" Value="#FFF1F2" /><Setter Property="BorderBrush" Value="#FECDD3" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding SystemCheckTitle}" Style="{StaticResource DisplayText}" FontSize="21" />
                                    <TextBlock Text="{Binding SystemCheckDescription}" Foreground="{StaticResource Slate600Brush}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20" />
                                    <TextBlock Text="{Binding SystemCheckGeneratedAt}" Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,12,0,0" />
                                </StackPanel>
                                <UniformGrid Grid.Column="1" Columns="3">
                                    <Border Background="White" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                                        <StackPanel><TextBlock Text="{Binding SystemCheckPassedCount}" Style="{StaticResource DisplayText}" Foreground="#047857" FontSize="24" /><TextBlock Text="PASSED" Foreground="#047857" FontSize="10" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0">
                                        <StackPanel><TextBlock Text="{Binding SystemCheckWarningCount}" Style="{StaticResource DisplayText}" Foreground="#B45309" FontSize="24" /><TextBlock Text="WARNINGS" Foreground="#B45309" FontSize="10" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="White" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                                        <StackPanel><TextBlock Text="{Binding SystemCheckFailedCount}" Style="{StaticResource DisplayText}" Foreground="#BE123C" FontSize="24" /><TextBlock Text="FAILED" Foreground="#BE123C" FontSize="10" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding SystemCheckExportMessageVisibility}" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                            <TextBlock Text="{Binding SystemCheckExportMessage}" Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>

                        <Border Visibility="{Binding SystemCheckEmptyVisibility}" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="34">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                                <Border Width="48" Height="48" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="24">
                                    <Border Width="15" Height="15" BorderBrush="#F97316" BorderThickness="3" CornerRadius="2" />
                                </Border>
                                <TextBlock Text="No system check results yet" Style="{StaticResource DisplayText}" FontSize="19" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                <TextBlock Text="System Check does not change the pairing or Hub configuration. It only creates and removes a small probe file to verify state-folder access." Foreground="{StaticResource Slate600Brush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SystemCheckItems}" Visibility="{Binding SystemCheckResultsVisibility}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="14,0,0,14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Slate300Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter Property="Background" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter Property="Background" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="20,17,22,17">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}" FontSize="17" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Slate700Brush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Recommendation, StringFormat=Action: {0}}" Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="9,5" Margin="0,17,18,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Slate100Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Background" Value="#D1FAE5" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter Property="Background" Value="#FFE4E6" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Slate600Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Foreground" Value="#047857" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter Property="Foreground" Value="#B45309" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter Property="Foreground" Value="#BE123C" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Diagnostics -->
                <Grid Visibility="{Binding DiagnosticsVisibility}" Margin="34,30,34,34">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Diagnostics" Style="{StaticResource DisplayText}" FontSize="30" />
                            <TextBlock Text="Review active errors and local logs without opening Event Viewer or a terminal." Foreground="{StaticResource Slate600Brush}" FontSize="15" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Open log folder" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,16" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource WarningBrush}" Margin="0,5,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Latest active error" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastError}" Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Navy950Brush}" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,13">
                                <Grid><TextBlock Text="RECENT AGENT LOGS" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" /><TextBlock HorizontalAlignment="Right" Text="Auto-refresh every 3 seconds" Foreground="#64748B" FontSize="11" /></Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd MMM HH:mm:ss} WIB}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#7DD3FC" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
